{
  "$schema": "https://json.schemastore.org/package",
  "name": "@fisch0920/config",
  "version": "1.4.1",
  "description": "Shared TypeScript, Oxlint, and Oxfmt configs for my projects.",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "transitive-bullshit/config",
  "files": [
    "*.ts",
    "*.json"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": "./oxfmt.config.ts",
    "./oxlint": "./oxlint.config.ts",
    "./tsconfig-node": "./tsconfig.node.json",
    "./tsconfig-react": "./tsconfig.react.json",
    "./ts-reset": "./ts-reset.d.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "run-p test:*",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:typecheck": "tsc",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "prerelease": "run-s test",
    "release": "np --yolo"
  },
  "dependencies": {
    "@total-typescript/ts-reset": "^0.6.1"
  },
  "devDependencies": {
    "lint-staged": "^17.3.0",
    "np": "^12.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxfmt": ">= 0.63.0",
    "oxlint": ">= 1.78",
    "typescript": ">= 6"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0"
}
