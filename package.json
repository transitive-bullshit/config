{
  "$schema": "https://json.schemastore.org/package",
  "name": "@fisch0920/config",
  "version": "2.3.0",
  "description": "Shared TypeScript, Oxlint, and Oxfmt configs for my projects.",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "transitive-bullshit/config",
  "files": [
    "build",
    "*.ts",
    "*.json"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": "./build/oxfmt.config.mjs",
    "./oxlint": "./build/oxlint.config.mjs",
    "./tsconfig-node": "./tsconfig.node.json",
    "./tsconfig-react": "./tsconfig.react.json",
    "./ts-reset": "./ts-reset.d.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "run-p test:*",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:typecheck": "tsc",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "posttest": "run-s build",
    "prerelease": "run-s test",
    "release": "release-it --only-version --github.release --github.autoGenerate"
  },
  "dependencies": {
    "@fisch0920/oxlint-plugin-anti-slop": "^0.2.1",
    "@total-typescript/ts-reset": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "release-it": "^21.1.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxfmt": ">= 0.63.0",
    "oxlint": ">= 1.78",
    "oxlint-tsgolint": ">= 7.0.2001",
    "typescript": ">= 7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1"
}
